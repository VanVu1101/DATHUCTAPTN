PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret

# Local development
USE_LOCAL_UPLOAD=true

# AWS deployment: set USE_LOCAL_UPLOAD=false.
# Prefer an EC2 IAM Role; access keys are then unnecessary.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-private-upload-bucket
AWS_S3_PUBLIC_READ=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
